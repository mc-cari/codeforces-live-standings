
# Public frontend origin allowed to open the SSE stream.
ALLOWED_ORIGIN=https://codeforces-live-standings.mccari.us

# Durable host directory for SQLite. Prefer SSD storage for long-running use.
LIVE_DATA_DIR=./.live-data

# Token for the named Cloudflare Tunnel used by docker-compose.live.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Shared with the Next.js server; use a randomly generated token (openssl rand -hex 32).
TELEMETRY_TOKEN=
# Existing Docker network containing Alloy.
ALLOY_NETWORK=grafanacloud_default

# Optional explicit ICPC wrong-attempt penalties (minutes), keyed by contest ID.
# Example: CF_ICPC_PENALTY_OVERRIDES='{"100001":7}'
CF_ICPC_PENALTY_OVERRIDES=
