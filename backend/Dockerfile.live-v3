FROM eclipse-temurin:17-jdk AS converter
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY vendor/live-v3/ ./
RUN ./gradlew --no-daemon :cds-converter:installDist -Plive.dev.embedFrontend=false

FROM golang:1.25-bookworm AS go-build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/live-backend .

FROM eclipse-temurin:17-jre
RUN useradd --system --uid 10001 --home-dir /nonexistent live && mkdir /data && chown live:live /data
COPY --from=converter /src/src/cds-converter/build/install/cds-converter/ /opt/live-v3/
COPY vendor/live-v3/LICENSE /opt/live-v3/LICENSE
COPY --from=go-build /out/live-backend /usr/local/bin/live-backend
USER live
ENV DATA_DIR=/data LISTEN_ADDR=:8080 STANDINGS_SOURCE=livev3 LIVE_V3_CONVERTER=/opt/live-v3/bin/cds-converter
VOLUME ["/data"]
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/live-backend"]
