CF_API_KEY=
CF_API_SECRET=

# Set this to the public URL of the Go SSE service to enable backend-driven live contests.
# Leave empty to use the legacy browser polling fallback.
NEXT_PUBLIC_LIVE_API_BASE_URL=

# Opt in at build time for production; leave false in previews/development.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
# Server-only: reachable Go backend URL (the public application port is fine).
TELEMETRY_API_BASE_URL=
# Must match TELEMETRY_TOKEN on the Go backend. Never prefix with NEXT_PUBLIC_.
TELEMETRY_TOKEN=
