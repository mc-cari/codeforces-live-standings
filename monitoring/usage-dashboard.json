    {
      "id": 18,
      "title": "Responses missing known submissions",
      "type": "stat",
      "description": "Successful contest.status responses compared by ID with locally retained history. Resets on backend restart. Counts affected responses, including repeated partial responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
