    {
      "id": 20,
      "title": "Submission responses missing known history (%)",
      "type": "timeseries",
      "description": "Percentage of successful contest.status responses omitting locally retained IDs. HTTP/API failures are excluded. No data until enough samples; no responses produces NaN.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(cf_codeforces_submission_responses_total{job=\"cf-live-standings\",history=\"missing_known\"}[$__rate_interval])) / sum(rate(cf_codeforces_submission_responses_total{job=\"cf-live-standings\"}[$__rate_interval]))",
          "legendFormat": "Missing known history",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
