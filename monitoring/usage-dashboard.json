    {
      "id": 1,
      "title": "Lifetime page views",
      "type": "stat",
      "description": "Committed lifetime events in SQLite. Starts at rollout; browser delivery is best effort.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (cf_usage_page_views_total{job=\"cf-live-standings\"})",
          "legendFormat": "{{mode}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
