      "title": "Known submission omissions",
      "type": "stat",
      "description": "Successful contest.status responses compared by ID with locally retained history. Resets on backend restart. Counts missing known IDs per response; the same ID can count again on later polls.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
